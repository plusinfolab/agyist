#!/usr/bin/env bash
# agyist - Unified Google Antigravity & Antigravity IDE Linux Installer & Manager Suite
# Usage:
#   agyist                          # Interactive TUI Wizard
#   agyist --ide                    # Install or update Antigravity IDE
#   agyist --desktop                # Install or update Antigravity 2.0 Desktop
#   agyist --all                    # Install or update both Antigravity IDE and Desktop
#   agyist --upgrade                # Check for updates and upgrade installed apps
#   agyist --sync                   # Bi-directionally sync chats, brains, and state
#   agyist --bundle [FILE]          # Generate standalone offline deployment bundle
#   agyist --setup-autoupdate       # Schedule automated background updates
#   agyist --check-update           # Check for updates (exit 0: up-to-date, 10: update available)
#   agyist --status [--json]        # View installation and memory diagnostics
#   agyist --backup [FILE]          # Backup brains, chats, memory, and settings
#   agyist --import <FILE>          # Restore / import brains & chats from backup archive
#   agyist --migrate                # Migrate legacy Antigravity to Antigravity IDE
#   agyist --uninstall              # Remove helper-managed binaries and integrations

set -euo pipefail

# Canonical symlink resolution to find true repository/install directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

if [ ! -f "$LIB_DIR/common.sh" ]; then
    for candidate in \
        "${XDG_DATA_HOME:-$HOME/.local/share}/agyist/lib" \
        "$HOME/Projects/agyist/lib" \
        "/usr/local/share/agyist/lib" \
        "/usr/share/agyist/lib"; do
        if [ -f "$candidate/common.sh" ]; then
            LIB_DIR="$candidate"
            SCRIPT_DIR="$(dirname "$LIB_DIR")"
            break
        fi
    done
fi

# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"
# shellcheck source=lib/resolver.sh
source "$LIB_DIR/resolver.sh"
# shellcheck source=lib/installer.sh
source "$LIB_DIR/installer.sh"
# shellcheck source=lib/backup.sh
source "$LIB_DIR/backup.sh"
# shellcheck source=lib/fleet.sh
source "$LIB_DIR/fleet.sh"
# shellcheck source=lib/watcher.sh
source "$LIB_DIR/watcher.sh"
# shellcheck source=lib/desktop.sh
source "$LIB_DIR/desktop.sh"
# shellcheck source=lib/cockpit.sh
source "$LIB_DIR/cockpit.sh"
# shellcheck source=lib/tui.sh
source "$LIB_DIR/tui.sh"

show_help() {
    print_banner
    cat <<'HELP_EOF'
Usage:
  agyist [COMMAND|OPTIONS]

Quick Commands:
  (no arguments)          Launch interactive TUI wizard (when run in a terminal)
  --ide                   Install or update Antigravity IDE
  --desktop               Install or update Antigravity 2.0 Desktop App
  --all                   Install or update both Antigravity IDE and Desktop App
  --upgrade, --update     Upgrade installed Antigravity components to latest official release
  --status                Display system status, paths, versions, and memory usage
  --uninstall             Remove installed Antigravity binaries, launchers, and desktop files

Chat, Brain & Memory Management:
  --sync, --sync-chat     Bi-directionally sync chats, brains & state (2.0 <-> IDE)
  --watch                 Run real-time background sync watcher daemon
  --setup-watch           Configure background systemd user service for auto-sync
  --remove-watch          Disable background auto-sync service
  --backup [FILE]         Create a full snapshot archive of agent brains, chats, and config
  --import FILE           Import and merge brains, chats, and config from a backup archive
  --migrate               Migrate legacy Antigravity v1 state/memory into Antigravity IDE

Fleet & Enterprise Automation:
  --bundle [FILE]         Generate standalone offline deployment bundle for office machines
  --setup-autoupdate      Configure automated daily/weekly background updates (systemd/cron)
  --remove-autoupdate     Disable automated background updates
  --check-update          Check if updates are available (exit 0: current, 10: update available)
  --self-update           Update agyist CLI suite itself from remote repository

Integrations & Third-Party Tools:
  --account, --verify-account Show active account status & verify Cockpit/IDE sync
  --cockpit [ide|desktop|both] Configure Cockpit Tools account switcher & launch path
  --restart-cockpit        Restart running Cockpit Tools daemon to reload configurations
  --diagnose-cockpit       Diagnose Cockpit Tools integration & path configuration
  --desktop-entry          Install Linux desktop launchers & URL protocol handlers (antigravity://)

Options & Flags:
  --target-dir DIR        Specify exact target installation directory
  --scope SCOPE           Installation scope: 'system' (/opt, /usr), 'user' (~/.local), or 'auto'
  --system                Shortcut for --scope system
  --user                  Shortcut for --scope user
  --force                 Force reinstallation even if already up to date
  --file ARCHIVE          Install from a local .tar.gz archive instead of downloading
  --offline               Install from bundled packages in ./packages/ directory
  --dry-run               Simulate actions without modifying files
  --json                  Output status or update information in JSON format
  -q, --quiet             Quiet mode (suppress banners and progress logs)
  -y, --yes               Non-interactive mode; assume yes to all prompts
  -h, --help              Show this help message

Exit Codes for --check-update:
  0                       All components are up to date
  10                      One or more updates are available

Examples:
  # Interactive wizard
  agyist

  # Fleet unattended upgrade of all machines
  agyist --upgrade -y -q

  # Bi-directionally synchronize chats and conversation brains
  agyist --sync

  # Create an offline bundle for air-gapped office PCs
  agyist --bundle ~/antigravity-office-bundle.tar.gz

  # Setup automated daily updates
  agyist --setup-autoupdate daily
HELP_EOF
}

# Default values
DO_IDE=0
DO_DESKTOP=0
DO_UPGRADE=0
DO_CHECK_UPDATE=0
DO_SYNC=0
DO_BUNDLE=0
BUNDLE_PATH=""
DO_SETUP_AUTOUPDATE=0
AUTOUPDATE_SCHEDULE="daily"
DO_REMOVE_AUTOUPDATE=0
DO_STATUS=0
DO_BACKUP=0
BACKUP_PATH=""
DO_IMPORT=0
IMPORT_PATH=""
DO_MIGRATE=0
DO_COCKPIT=0
COCKPIT_TARGET=""
DO_RESTART_COCKPIT=0
DO_DIAGNOSE_COCKPIT=0
DO_ACCOUNT=0
DO_WATCH=0
DO_SETUP_WATCH=0
DO_REMOVE_WATCH=0
DO_DESKTOP_ENTRY=0
DO_UNINSTALL=0
DO_SELF_UPDATE=0
TARGET_DIR=""
SCOPE="auto"
FORCE=0
YES=0
DRY_RUN=0
JSON_OUTPUT=0
LOCAL_ARCHIVE=""

if [ $# -eq 0 ]; then
    if [ -t 0 ]; then
        run_interactive_menu
        exit 0
    else
        show_help
        exit 0
    fi
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --ide)
            DO_IDE=1
            ;;
        --desktop)
            DO_DESKTOP=1
            ;;
        --all)
            DO_IDE=1
            DO_DESKTOP=1
            ;;
        --upgrade|--update|update|upgrade)
            DO_UPGRADE=1
            ;;
        --self-update|--update-self|--update-agyist)
            DO_SELF_UPDATE=1
            ;;
        --check-update|check-update)
            DO_CHECK_UPDATE=1
            ;;
        --sync|--sync-chat|sync)
            DO_SYNC=1
            ;;
        --bundle|bundle)
            DO_BUNDLE=1
            if [ $# -gt 1 ] && [[ "$2" != --* ]]; then
                BUNDLE_PATH="$2"
                shift
            fi
            ;;
        --setup-autoupdate|setup-autoupdate)
            DO_SETUP_AUTOUPDATE=1
            if [ $# -gt 1 ] && [[ "$2" != --* ]]; then
                AUTOUPDATE_SCHEDULE="$2"
                shift
            fi
            ;;
        --remove-autoupdate|remove-autoupdate)
            DO_REMOVE_AUTOUPDATE=1
            ;;
        --status|status)
            DO_STATUS=1
            ;;
        --json)
            JSON_OUTPUT=1
            ;;
        -q|--quiet)
            QUIET=1
            ;;
        --backup|backup)
            DO_BACKUP=1
            if [ $# -gt 1 ] && [[ "$2" != --* ]]; then
                BACKUP_PATH="$2"
                shift
            fi
            ;;
        --import|--restore|import|restore)
            DO_IMPORT=1
            [ $# -gt 1 ] || { log_error "--import requires an archive path argument"; exit 1; }
            IMPORT_PATH="$2"
            shift
            ;;
        --migrate|migrate)
            DO_MIGRATE=1
            ;;
        --cockpit|--fix-cockpit|cockpit)
            DO_COCKPIT=1
            if [ $# -gt 1 ] && [[ "$2" =~ ^(ide|desktop|2\.0|both|all)$ ]]; then
                COCKPIT_TARGET="$2"
                shift
            fi
            ;;
        --diagnose-cockpit)
            DO_DIAGNOSE_COCKPIT=1
            ;;
        --restart-cockpit)
            DO_RESTART_COCKPIT=1
            ;;
        --account|--verify-account|--verify-switch|account)
            DO_ACCOUNT=1
            ;;
        --watch|watch)
            DO_WATCH=1
            ;;
        --setup-watch)
            DO_SETUP_WATCH=1
            ;;
        --remove-watch)
            DO_REMOVE_WATCH=1
            ;;
        --desktop-entry|--setup-desktop)
            DO_DESKTOP_ENTRY=1
            ;;
        --uninstall|uninstall)
            DO_UNINSTALL=1
            ;;
        --target-dir)
            [ $# -gt 1 ] || { log_error "--target-dir requires a directory path"; exit 1; }
            TARGET_DIR="$2"
            shift
            ;;
        --scope)
            [ $# -gt 1 ] || { log_error "--scope requires 'system', 'user', or 'auto'"; exit 1; }
            SCOPE="$2"
            shift
            ;;
        --system)
            SCOPE="system"
            ;;
        --user)
            SCOPE="user"
            ;;
        --force)
            FORCE=1
            ;;
        --dry-run)
            DRY_RUN=1
            ;;
        --file)
            [ $# -gt 1 ] || { log_error "--file requires a path to tar.gz archive"; exit 1; }
            LOCAL_ARCHIVE="$2"
            shift
            ;;
        --offline)
            if [ -f "$SCRIPT_DIR/packages/antigravity-ide.tar.gz" ]; then
                LOCAL_ARCHIVE="$SCRIPT_DIR/packages/antigravity-ide.tar.gz"
            fi
            ;;
        -y|--yes)
            YES=1
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        *)
            log_error "Unknown option: $1"
            echo "Run 'agyist --help' for usage."
            exit 1
            ;;
    esac
    shift
done

# Dispatch non-install commands first
if [ "$DO_STATUS" -eq 1 ]; then
    show_system_status "$JSON_OUTPUT"
    exit 0
fi

if [ "$DO_CHECK_UPDATE" -eq 1 ]; then
    existing="$(detect_existing_installations)"
    if [ -z "$existing" ]; then
        log_warn "No installations detected to check."
        check_for_updates "ide" ""
        exit $?
    fi

    has_update=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        item_type="${line%%:*}"
        item_path="${line#*:}"
        log_step "Checking updates for [$item_type] at $item_path..."
        if ! check_for_updates "$item_type" "$item_path"; then
            has_update=1
        fi
        echo ""
    done <<< "$existing"

    if [ "$has_update" -eq 1 ]; then
        log_info "Update(s) available for installed components."
        exit 10
    else
        log_success "All installed components are up to date."
        exit 0
    fi
fi

if [ "$DO_SYNC" -eq 1 ]; then
    run_sync "$DRY_RUN"
    exit 0
fi

if [ "$DO_BUNDLE" -eq 1 ]; then
    create_offline_bundle "$BUNDLE_PATH" 1 1
    exit 0
fi

if [ "$DO_SETUP_AUTOUPDATE" -eq 1 ]; then
    setup_autoupdate "$AUTOUPDATE_SCHEDULE" "$SCOPE"
    exit 0
fi

if [ "$DO_REMOVE_AUTOUPDATE" -eq 1 ]; then
    remove_autoupdate
    exit 0
fi

if [ "$DO_BACKUP" -eq 1 ]; then
    run_backup "$BACKUP_PATH"
    exit 0
fi

if [ "$DO_IMPORT" -eq 1 ]; then
    run_import "$IMPORT_PATH"
    exit 0
fi

if [ "$DO_MIGRATE" -eq 1 ]; then
    run_migration_wrapper "$DRY_RUN"
    exit 0
fi

if [ "$DO_DIAGNOSE_COCKPIT" -eq 1 ]; then
    diagnose_cockpit
    exit 0
fi

if [ "$DO_ACCOUNT" -eq 1 ]; then
    show_account_status "$JSON_OUTPUT"
    exit 0
fi

if [ "$DO_WATCH" -eq 1 ]; then
    run_state_watcher "$DRY_RUN"
    exit 0
fi

if [ "$DO_SETUP_WATCH" -eq 1 ]; then
    setup_watch_service
    exit 0
fi

if [ "$DO_REMOVE_WATCH" -eq 1 ]; then
    remove_watch_service
    exit 0
fi

if [ "$DO_DESKTOP_ENTRY" -eq 1 ]; then
    setup_desktop_integrations "$DRY_RUN"
    exit 0
fi

if [ "$DO_COCKPIT" -eq 1 ]; then
    fix_cockpit_integration "$COCKPIT_TARGET"
    exit 0
fi

if [ "$DO_RESTART_COCKPIT" -eq 1 ]; then
    # shellcheck source=lib/cockpit.sh
    source "$SCRIPT_DIR/cockpit.sh"
    restart_cockpit_tools
    exit 0
fi

if [ "$DO_UNINSTALL" -eq 1 ]; then
    if [ "$YES" -eq 0 ]; then
        read -rp "Are you sure you want to remove Antigravity helper-managed files? [y/N]: " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || { log_info "Uninstall aborted."; exit 0; }
    fi
    run_uninstall
    exit 0
fi

if [ "$DO_SELF_UPDATE" -eq 1 ]; then
    self_update_agyist "$DRY_RUN"
    exit 0
fi

if [ "$DO_UPGRADE" -eq 1 ]; then
    self_update_agyist "$DRY_RUN" 2>/dev/null || true
    upgrade_all_installations "$FORCE" "$SCOPE"
    exit 0
fi

# Execute explicit installs
if [ "$DO_IDE" -eq 1 ]; then
    install_product "ide" "$TARGET_DIR" "$SCOPE" "$FORCE" "$LOCAL_ARCHIVE"
fi

if [ "$DO_DESKTOP" -eq 1 ]; then
    install_product "desktop" "$TARGET_DIR" "$SCOPE" "$FORCE" "$LOCAL_ARCHIVE"
fi
